# ── Server ──────────────────────────────────────────────
NODE_ENV=production
PORT=8080
# Comma-separated list of allowed CORS origins (no trailing slash)
ALLOWED_ORIGIN=https://app.yourdomain.com

# ── Supabase (required) ─────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — server-side only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Postgres direct connection (optional, used for FCM tokens) ──
# Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=

# ── Firebase Cloud Messaging (optional) ─────────────────
# Single-line JSON of the Firebase service account. Can also be set from
# Admin → Settings, where it is persisted to the `settings` table.
FIREBASE_SERVICE_ACCOUNT=

# ── Integrations ────────────────────────────────────────
# These can be set here for first boot, but are normally managed from
# Admin → Settings and stored in the `settings` table.
GEMINI_API_KEY=
DAILY_API_KEY=
DAILY_DOMAIN=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
