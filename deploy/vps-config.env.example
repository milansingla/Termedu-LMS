# ═══════════════════════════════════════════════════════════════════════════════
#  T.E.R.M. EDU — VPS CONFIG FILE
#  Copy to vps-config.env and fill in the values (see docs/DEPLOYMENT.md)
#
#  ★  All API keys that change often (Daily.co, Gemini, SMTP) are managed
#     inside the Admin → Settings panel — you do NOT need them here.
#     Only the keys below are required to start the server.
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────────────────────────────────────

# Port the Node.js API server listens on (Nginx will proxy from 80/443 → this)
PORT=8080

# Node.js version to install (keep at 20 — matches Replit)
NODE_VERSION=20

# Absolute path where the project will be deployed on the VPS
APP_DIR=/var/www/termedu

# Your production domain (used for Nginx config + CORS)
# Leave empty if you only want to access via IP:PORT
DOMAIN=app.yourdomain.com

# Comma-separated allowed origins for CORS (your domain, no trailing slash)
# Example: https://app.yourdomain.com
ALLOWED_ORIGIN=https://app.yourdomain.com

# Install Nginx automatically? (yes / no)
INSTALL_NGINX=yes


# ─────────────────────────────────────────────────────────────────────────────
#  SUPABASE  (required — the database backing the entire app)
# ─────────────────────────────────────────────────────────────────────────────

# Found in: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Found in: Supabase Dashboard → Settings → API → service_role secret
# Keep this private — it bypasses Row Level Security
SUPABASE_SERVICE_KEY=your_supabase_service_role_key


# ─────────────────────────────────────────────────────────────────────────────
#  POSTGRES DIRECT CONNECTION  (optional — only if you query the DB directly)
# ─────────────────────────────────────────────────────────────────────────────

# Found in: Supabase Dashboard → Settings → Database → Connection string (URI)
# Leave blank if you only use the Supabase JS client above
DATABASE_URL=


# ─────────────────────────────────────────────────────────────────────────────
#  FIREBASE / FCM  (push notifications for the Android app)
# ─────────────────────────────────────────────────────────────────────────────
#
#  The credentials file is:  server/firebase-admin.json
#  Download it from:  Firebase Console → Project Settings → Service Accounts
#                     → Generate new private key
#  Place the downloaded JSON at:  server/firebase-admin.json
#  No env var needed — the file is loaded directly by the server.
#
#  FCM settings (managed in Admin → Settings, not here):
#    • Android notification channel: support_replies
#    • Online threshold: 90 seconds (student heartbeat every 30s)


# ─────────────────────────────────────────────────────────────────────────────
#  API KEYS MANAGED IN ADMIN PANEL  (do NOT put them here)
# ─────────────────────────────────────────────────────────────────────────────
#
#  Log into your app as Admin → go to Settings → fill in:
#
#  ┌─────────────────┬──────────────────────────────────────────────────────┐
#  │ Key             │ Where to get it                                      │
#  ├─────────────────┼──────────────────────────────────────────────────────┤
#  │ DAILY_API_KEY   │ dashboard.daily.co → Developers → API keys          │
#  │ DAILY_DOMAIN    │ dashboard.daily.co → your subdomain (e.g. term-edu) │
#  │ GEMINI_API_KEY  │ aistudio.google.com → Get API key                   │
#  │ SMTP_HOST       │ Your email provider (e.g. smtp.gmail.com)            │
#  │ SMTP_PORT       │ 465 (SSL) or 587 (TLS)                               │
#  │ SMTP_USER       │ Your sending email address                           │
#  │ SMTP_PASS       │ App password from your email provider                │
#  │ SMTP_FROM       │ Display name + email (e.g. T.E.R.M. Edu)            │
#  │ SMTP_SECURE     │ true (for port 465)                                  │
#  └─────────────────┴──────────────────────────────────────────────────────┘
#
#  These are stored encrypted in your Supabase `settings` table and loaded
#  automatically when the server starts — no restart needed after changing them.


# ─────────────────────────────────────────────────────────────────────────────
#  USEFUL PM2 COMMANDS (after deploy)
# ─────────────────────────────────────────────────────────────────────────────
#
#  pm2 logs termedu          — live server logs
#  pm2 restart termedu       — restart after a code change
#  pm2 stop termedu          — stop the server
#  pm2 monit                 — CPU / memory monitor
#
# ─────────────────────────────────────────────────────────────────────────────
#  SSL / HTTPS (after Nginx is set up)
# ─────────────────────────────────────────────────────────────────────────────
#
#  sudo apt install -y certbot python3-certbot-nginx
#  sudo certbot --nginx -d app.yourdomain.com
#  (Certbot auto-renews every 90 days)
